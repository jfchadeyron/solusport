# Configuration Apache pour l’hébergement o2switch de solusport.com.
Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS obligatoire, sauf pour la validation du certificat (AutoSSL / Let’s Encrypt).
  # o2switch peut terminer le TLS en amont : X-Forwarded-Proto évite une boucle.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} !on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www.solusport.com redirige vers solusport.com.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Anciennes adresses des offres.
Redirect 301 /commsport.html /gestionsport.html
Redirect 301 /managesport.html /gestionsport.html
Redirect 301 /wearsport.html /equipsport.html

# Fichiers cachés (dont l’état de synchronisation FTP) inaccessibles depuis le Web.
RedirectMatch 404 "/\.(?!well-known/)"

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
